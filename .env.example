# Copy to .env on the server. Never commit real credentials.
DATABASE_URL="file:/opt/kontenai/db/custom.db"
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional: choose a text model supported by your OpenAI project.
OPENAI_TEXT_MODEL=gpt-6-luna
