# Copy to .env on the server. Never commit real credentials.
DATABASE_URL="file:/opt/kontenai/db/custom.db"
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Required administrator credentials. Use long, unique random values.
ADMIN_PASSWORD=
AUTH_SECRET=

# OpenAI credentials; server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TTS_MODEL=gpt-4o-mini-tts
